#!/bin/sh
# Container main process (PID 1). It independently supervises OpenCode and DSH
# Web when enabled. Each loop reloads ~/.env before launching its child so module
# environment changes take effect after a cheap child bounce rather than a full
# container recreation.

# Every workspace is assigned its own loopback port by the manager (passed in as
# OCM_OPENCODE_PORT). There is no shared default: under host networking a fallback
# port would collide with another workspace, so a missing value is a manager bug
# we fail loudly on rather than silently bind the wrong port.
if [ -z "$OCM_OPENCODE_PORT" ]; then
  echo "opencode-manager: OCM_OPENCODE_PORT is not set; the manager must assign each workspace its own port" >&2
  exit 1
fi

# The manager mounts optional host CA certificates read-only. Install them into
# the Debian trust store before starting OpenCode so all workspace tools trust them.
installed=false
for certificate in /run/opencode-manager-extra-ca-*.crt; do
  [ -f "$certificate" ] || continue
  sudo install -m 0644 "$certificate" "/usr/local/share/ca-certificates/${certificate##*/}" || exit 1
  installed=true
done
if [ "$installed" = true ]; then
  sudo update-ca-certificates || exit 1
fi

# The home is bind-mounted, so image-build ownership fixes do not apply to an
# existing Claude directory. Repair an unwritable directory before Claude or its
# updater starts, preserving its existing credentials and settings.
if [ -d "$HOME/.claude" ] && [ ! -w "$HOME/.claude" ]; then
  sudo chown -R "$(id -u):$(id -g)" "$HOME/.claude" || exit 1
fi
mkdir -p -m 0700 "$HOME/.claude" || exit 1

# Keep Claude Code current. The image ships the npm build in the root-owned global
# node_modules, where Claude's own auto-updater cannot write as the workspace
# user, so it would stay at whatever version the image was built with. Install
# the native build into the persistent home instead (~/.local/bin is first on
# PATH, so it takes over from the image's copy) and update it on every start;
# while Claude runs, its built-in auto-updater keeps that copy current. Runs in
# the background and never blocks or fails the workspace: when it can't reach
# the network the image's build simply stays in use.
update_claude() {
  if [ -x "$HOME/.local/bin/claude" ]; then
    "$HOME/.local/bin/claude" update
  elif command -v claude >/dev/null 2>&1; then
    claude install
  fi
}
update_claude >/tmp/opencode-manager-claude-update.log 2>&1 &

serve_opencode() {
  child=""
  shutdown() { [ -n "$child" ] && kill -TERM "$child" 2>/dev/null; exit 0; }
  trap shutdown TERM INT
  while true; do
    set -a
    [ -f "$HOME/.env" ] && . "$HOME/.env"
    set +a
    opencode serve --hostname 127.0.0.1 --port "$OCM_OPENCODE_PORT" &
    child=$!
    wait "$child"
    child=""
    sleep 0.5
  done
}

serve_dsh() {
  child=""
  output=""
  shutdown() {
    [ -n "$child" ] && kill -TERM "$child" 2>/dev/null
    [ -n "$output" ] && kill -TERM "$output" 2>/dev/null
    exit 0
  }
  trap shutdown TERM INT
  while true; do
    set -a
    [ -f "$HOME/.env" ] && . "$HOME/.env"
    set +a

    token_file="$DSH_HOME/web-token"
    token_pipe="$(mktemp -u)"
    mkfifo "$token_pipe"
    rm -f "$token_file"
    dsh web --port "$OCM_DSH_PORT" --no-open >"$token_pipe" 2>&1 &
    child=$!
    (
      while IFS= read -r line; do
        printf '%s\n' "$line"
        case "$line" in
          *"?token="*)
            token="${line##*?token=}"
            token="${token%%[[:space:]]*}"
            if [ -n "$token" ]; then
              umask 077
              temporary="${token_file}.tmp"
              printf '%s\n' "$token" >"$temporary"
              mv -f "$temporary" "$token_file"
            fi
            ;;
        esac
      done <"$token_pipe"
    ) &
    output=$!
    wait "$child"
    child=""
    wait "$output" 2>/dev/null
    output=""
    rm -f "$token_pipe"
    sleep 0.5
  done
}

serve_opencode &
opencode_supervisor=$!
dsh_supervisor=""
if [ -n "${OCM_DSH_PORT:-}" ]; then
  serve_dsh &
  dsh_supervisor=$!
fi

shutdown() {
  kill -TERM "$opencode_supervisor" 2>/dev/null
  [ -n "$dsh_supervisor" ] && kill -TERM "$dsh_supervisor" 2>/dev/null
  wait "$opencode_supervisor" 2>/dev/null
  [ -n "$dsh_supervisor" ] && wait "$dsh_supervisor" 2>/dev/null
  exit 0
}
trap shutdown TERM INT
wait "$opencode_supervisor"
