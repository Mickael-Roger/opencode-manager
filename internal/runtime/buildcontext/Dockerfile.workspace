# Per-workspace image: adds the host user (UID/GID) on top of the resolved base
# image so files written into the bind-mounted home keep host ownership.
# Passwordless sudo is granted to ALL users here as well as in the base image.
# This keeps workspace images safe when they are rebuilt from an older local base
# image whose sudoers rule predates the numeric --user UID:GID runtime model.
ARG BASE_IMAGE=docker.io/mroger78/ocm-base:latest
FROM ${BASE_IMAGE}

ARG UID
ARG GID

RUN set -eux; if getent group ${GID}; then group_name=$(getent group ${GID} | cut -d: -f1); else groupadd -g ${GID} debian && group_name=debian; fi; if getent passwd ${UID}; then user_name=$(getent passwd ${UID} | cut -d: -f1); usermod -d /home/debian -s /bin/bash ${user_name}; else useradd -m -u ${UID} -g ${GID} -s /bin/bash debian; user_name=debian; fi; mkdir -p /home/debian/workspace && chown -R ${UID}:${GID} /home/debian
RUN echo 'ALL ALL=(ALL:ALL) NOPASSWD:ALL' > /etc/sudoers.d/opencode-manager && chmod 0440 /etc/sudoers.d/opencode-manager
# Refresh manager-owned scripts even when the resolved base image is cached.
COPY opencode-manager-attach /usr/local/bin/opencode-manager-attach
COPY opencode-manager-entrypoint /usr/local/bin/opencode-manager-entrypoint
COPY opencode-pending-prompts.patch /usr/local/share/opencode-manager/opencode-pending-prompts.patch
COPY opencode-manager-patch-pending-prompts /usr/local/bin/opencode-manager-patch-pending-prompts
RUN chmod 0755 /usr/local/bin/opencode-manager-attach /usr/local/bin/opencode-manager-entrypoint /usr/local/bin/opencode-manager-patch-pending-prompts && /usr/local/bin/opencode-manager-patch-pending-prompts
WORKDIR /home/debian/workspace
