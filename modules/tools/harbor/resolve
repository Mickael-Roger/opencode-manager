#!/bin/sh
# Host-side resolve hook: when requested, package this host's Harbor user
# configuration for the workspace. Tokens can live in .env, custom profiles,
# and service override.env files. The archive is passed only to install and is
# never written to the manifest; re-running resolve tracks host changes.
set -e

case "$OCM_IMPORT_CONFIG" in
  yes | true | 1 | on) ;;
  *) exit 0 ;;
esac

home="${HARBOR_HOME:-$HOME/.harbor}"
[ -d "$home" ] || exit 0

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Do not include Harbor's source tree, downloaded models, caches, or default
# profile. Only copy user-managed configuration that can contain credentials.
cd "$home"
set --
[ -f .env ] && set -- "$@" .env
for profile in profiles/*; do
  [ -f "$profile" ] && [ "${profile##*/}" != default.env ] && set -- "$@" "$profile"
done
for override in services/*/override.env; do
  [ -f "$override" ] && set -- "$@" "$override"
done
[ "$#" -gt 0 ] || exit 0
tar -czf "$tmp" "$@"

b64="$(base64 < "$tmp" | tr -d '\n')"
[ -n "$b64" ] && printf 'config_b64=%s\n' "$b64"
