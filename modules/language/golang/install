#!/bin/sh
# Runs inside the workspace container. Installs the Go toolchain to /usr/local/go
# (the selected version, resolved to the latest matching patch), the Go dev tools
# (gopls LSP, delve, goimports) into ~/go/bin, and exports GOPATH/PATH through a
# marked block in ~/.env. Idempotent: the toolchain dir is replaced, tool installs
# are re-runnable, and the ~/.env block is rewritten in place, so reconcile can
# re-run this safely.
set -e

: "${OCM_VERSION:=latest}"

# Guard the tools needed for downloads and the container-side install lock.
for bin in curl jq flock; do
  if ! command -v "$bin" >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y --no-install-recommends curl jq ca-certificates util-linux
    break
  fi
done

# A timed-out/killed host CLI can leave its docker exec script running. Keep a
# container-side lock as well, including the dev-tool installs and ~/.env write.
mkdir -p "$HOME/.cache/opencode-manager"
exec 9>"$HOME/.cache/opencode-manager/golang.lock"
flock -x 9

# Private downloads prevent another install from truncating our archive. Stage
# extraction on the destination filesystem, leaving the working toolchain alone
# until the download, checksum, extraction, and binary have all been validated.
download_dir="$(mktemp -d)"
stage_dir=
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$stage_dir" ]; then
    if [ -d "$stage_dir/previous" ] && [ ! -e /usr/local/go ]; then
      if ! sudo mv "$stage_dir/previous" /usr/local/go; then
        echo "golang: previous toolchain preserved in $stage_dir/previous" >&2
        rm -rf "$download_dir"
        exit 1
      fi
    fi
    sudo rm -rf "$stage_dir"
  fi
  rm -rf "$download_dir"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

download() {
  curl -fsSL --retry 3 --retry-all-errors --connect-timeout 15 --max-time 300 "$1" -o "$2"
}

case "$(dpkg --print-architecture 2>/dev/null || echo amd64)" in
  arm64 | aarch64) garch=arm64 ;;
  amd64 | x86_64) garch=amd64 ;;
  *) echo "golang: unsupported architecture" >&2; exit 1 ;;
esac

# Resolve both the version and its official SHA-256 from the same index.
download 'https://go.dev/dl/?mode=json&include=all' "$download_dir/releases.json"
jq -er --arg v "$OCM_VERSION" --arg arch "$garch" '
  [.[] | select(.stable)
   | select($v == "latest" or .version == ("go" + $v) or (.version | startswith("go" + $v + ".")))
   | .files[] | select(.os == "linux" and .arch == $arch and .kind == "archive")]
  | first | select(. != null)
' "$download_dir/releases.json" > "$download_dir/release.json"
tarball="$(jq -er '.filename' "$download_dir/release.json")"
checksum="$(jq -er '.sha256 | select(test("^[0-9a-f]{64}$"))' "$download_dir/release.json")"
goversion="$(jq -er '.version' "$download_dir/release.json")"

# A successful HTTP transfer can still deliver a bad archive. Retry integrity
# failures too, always overwriting only this invocation's private download.
attempt=1
while :; do
  download "https://go.dev/dl/${tarball}" "$download_dir/go.tar.gz"
  printf '%s  %s\n' "$checksum" "$download_dir/go.tar.gz" > "$download_dir/checksum"
  if sha256sum -c "$download_dir/checksum"; then
    break
  fi
  if [ "$attempt" -ge 3 ]; then
    echo "golang: archive checksum failed after $attempt attempts" >&2
    exit 1
  fi
  attempt=$((attempt + 1))
  sleep 1
done

stage_dir="$(sudo mktemp -d /usr/local/.ocm-go.XXXXXX)"
sudo tar -C "$stage_dir" -xzf "$download_dir/go.tar.gz"
sudo "$stage_dir/go/bin/go" version
if [ -e /usr/local/go ]; then
  sudo mv /usr/local/go "$stage_dir/previous"
fi
sudo mv "$stage_dir/go" /usr/local/go

echo "go ${goversion} installed to /usr/local/go"

# Install the dev environment into GOPATH/bin (~/go/bin). gopls is the language
# server; goimports and delve round out a usable Go setup.
export GOPATH="$HOME/go"
export PATH="/usr/local/go/bin:$GOPATH/bin:$PATH"
go install golang.org/x/tools/gopls@latest
go install golang.org/x/tools/cmd/goimports@latest
go install github.com/go-delve/delve/cmd/dlv@latest

echo "go dev tools installed: gopls, goimports, dlv"

# Export GOPATH/PATH through a marked block in ~/.env so the toolchain and tools
# reach the server and shells. Rewrite the block (delete then append) so reconcile
# never duplicates it. $HOME/$PATH stay literal (single-quoted heredoc) so they
# expand when ~/.env is sourced.
ENV_FILE="$HOME/.env"
touch "$ENV_FILE"
sed -i '/# >>> ocm:golang >>>/,/# <<< ocm:golang <<</d' "$ENV_FILE"
cat >>"$ENV_FILE" <<'EOF'
# >>> ocm:golang >>>
export GOPATH="$HOME/go"
export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"
# <<< ocm:golang <<<
EOF

echo "golang environment written to ~/.env"
