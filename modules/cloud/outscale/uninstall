#!/bin/sh
# Removes only this profile from ~/.osc/config.json and the matching AWS profile
# from ~/.aws/{credentials,config}, leaving other profiles and the octl/aws
# binaries in place (matching how other modules leave system tools).
set -e

: "${OCM_PROFILE:=default}"

cfg="$HOME/.osc/config.json"
if [ -f "$cfg" ]; then
  tmp="$(mktemp)"
  jq --arg p "$OCM_PROFILE" 'del(.[$p])' "$cfg" >"$tmp"
  mv "$tmp" "$cfg"
  chmod 600 "$cfg"
fi

# Delete the profile's INI section from an ~/.aws file: drop the header line and
# every line until the next section header, leaving other profiles untouched.
del_aws_section() {
  file="$1"
  header="$2"
  [ -f "$file" ] || return 0
  tmp="$(mktemp)"
  awk -v hdr="$header" '
    $0 == hdr { skip = 1; next }
    /^[[:space:]]*\[/ { skip = 0 }
    !skip { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
  chmod 600 "$file"
}
del_aws_section "$HOME/.aws/credentials" "[$OCM_PROFILE]"
del_aws_section "$HOME/.aws/config" "[profile $OCM_PROFILE]"

echo "outscale profile '$OCM_PROFILE' removed"
