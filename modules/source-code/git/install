#!/bin/sh
# Configures git from values resolved off the host and clones the requested
# repository into the workspace home directory. Idempotent: identity/signing
# config is (re)written only for values the host actually provides, and a repo
# whose target directory already exists is left untouched, so reconcile never
# re-clones or clobbers local work.
set -e

# Install git if missing (needed for both the config below and cloning).
if ! command -v git >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends git
fi

# Identity comes from the host via the resolve hook; set only what the host has,
# otherwise leave git to its own defaults rather than writing empty values.
if [ -n "$OCM_NAME" ]; then
  git config --global user.name "$OCM_NAME"
fi
if [ -n "$OCM_EMAIL" ]; then
  git config --global user.email "$OCM_EMAIL"
fi
if [ -n "$OCM_NAME" ] || [ -n "$OCM_EMAIL" ]; then
  echo "git identity configured: ${OCM_NAME:-unset} <${OCM_EMAIL:-unset}>"
fi

# OpenPGP signing config comes from the host resolve hook. The secret key is not
# persisted in the workspace manifest; it is passed only for this install run.
if [ -n "$OCM_GPG_SECRET_KEY_B64" ] && [ -n "$OCM_GPG_SIGNINGKEY" ]; then
  if ! command -v gpg >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y --no-install-recommends gnupg
  fi
  mkdir -p "$HOME/.gnupg"
  chmod 700 "$HOME/.gnupg"
  printf '%s' "$OCM_GPG_SECRET_KEY_B64" | base64 -d | gpg --batch --import >/dev/null 2>&1
  git config --global user.signingkey "$OCM_GPG_SIGNINGKEY"
  git config --global gpg.format openpgp
  git config --global gpg.program gpg
  if [ -n "$OCM_GPG_COMMIT_SIGN" ]; then
    git config --global commit.gpgsign "$OCM_GPG_COMMIT_SIGN"
  fi
  if [ -n "$OCM_GPG_TAG_SIGN" ]; then
    git config --global tag.gpgsign "$OCM_GPG_TAG_SIGN"
  fi
  echo "git OpenPGP signing key configured: $OCM_GPG_SIGNINGKEY"
fi

# No repo to clone (e.g. an identity-only legacy entry): identity is configured
# above, nothing left to do.
if [ -z "$OCM_REPO" ]; then
  echo "no repository specified; git identity configured only"
  exit 0
fi

# is_ssh_url reports whether a clone URL goes over SSH (ssh:// or scp-like
# git@host:path), as opposed to http(s). Such clones need the OpenSSH client.
is_ssh_url() {
  case "$1" in
    ssh://*) return 0 ;;
    *://*) return 1 ;;
    *@*:*) return 0 ;;
    *) return 1 ;;
  esac
}

# ensure_ssh_client installs the OpenSSH client the first time an SSH URL is
# cloned. The keys/host config themselves come from the ssh module; here we only
# make sure the `ssh` binary git shells out to actually exists.
ensure_ssh_client() {
  command -v ssh >/dev/null 2>&1 && return 0
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends openssh-client
}

# Clone into the workspace directory (~/workspace, the container's working dir),
# not the home root, so repos sit alongside the work the agent runs on.
mkdir -p "$HOME/workspace"
name="$(basename "$OCM_REPO" .git)"
dest="$HOME/workspace/$name"
if [ -e "$dest" ]; then
  echo "git repo '$name' already present, skipping"
  exit 0
fi

if is_ssh_url "$OCM_REPO"; then
  ensure_ssh_client
  # Auto-accept the host key on first contact so an SSH clone never hangs on the
  # interactive "authenticity of host ... can't be established" prompt. accept-new
  # records an unknown key in ~/.ssh/known_hosts but still refuses a *changed* key,
  # so it does not blindly trust a key swap.
  GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new" git clone "$OCM_REPO" "$dest"
else
  git clone "$OCM_REPO" "$dest"
fi
echo "git repo cloned: $OCM_REPO -> $dest"
